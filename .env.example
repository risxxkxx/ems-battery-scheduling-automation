# Public template only. Never commit real production values.

MQTT_BROKER=
MQTT_PORT=1883
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
CONTROLLER_SN=

# IANA timezone, for example UTC or Europe/Skopje.
TIMEZONE=UTC

# Configure locally using 24-hour HH:MM values.
SELF_CONSUMPTION_START=
SELF_CONSUMPTION_END=
COST_START=
COST_END=

# Installation-specific limits. Keep real production values out of Git.
SITE_IMPORT_LIMIT_W=0
SITE_EXPORT_LIMIT_W=0

# Raw MQTT feedback may include controller/site identifiers.
DEBUG_PAYLOADS=false
